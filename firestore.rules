rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Shared Checklist Collection for Amar City team
    match /checklists/{documentId} {
      // Allow authenticated team members to read and update the shared launch checklist
      allow read, create, update: if isAuthenticated();
      // Prevent accidental document deletion
      allow delete: if false;
    }

    // Deny access to any other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
